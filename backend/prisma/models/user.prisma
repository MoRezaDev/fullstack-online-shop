model User {
    id String @id @default(cuid())

    mobile String @unique
    full_name String?
    email String?
    password String?
    role String @default("user")
    is_user_active Boolean @default(true)
    
    address Address[]
    cart Cart?
    otp Otp?
    rating ProductRating[]
    comments Comment[]
    orders Order[]

}