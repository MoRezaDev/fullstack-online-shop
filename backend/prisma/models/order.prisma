model Order {
    id String @id @default(cuid())

    status String @default("pending")
    order_number Int @unique
    order_date String
    delivery_date String
    
    total_price Int 
    total_discounts Int
    selling_price Int

    addressId String
    address Address @relation(fields: [addressId],references: [id])

    payment_details PaymentDetail?

    userId String
    user User @relation(fields: [userId],references: [id],onDelete: Cascade)

    order_items OrderItem[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model PaymentDetail {
    id String @id @default(cuid())

    status String @default("pending")
    verify_code Int @unique
    transaction_code Int? @unique 

    price Int
    paid_price Int @default(0)
    paid_date String @default("pending")

    transaction_history TransactionHistory[]

    orderId String @unique
    order Order @relation(fields: [orderId],references: [id],onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model TransactionHistory {
    id String @id @default(cuid())

    status String @default("pending")
    transaction_date String 
    transaction_time String

    paymentDetailId String 
    paymentDetail PaymentDetail @relation(fields: [paymentDetailId],references: [id],onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}