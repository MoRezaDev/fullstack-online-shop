model Brand {
    id String @id @default(cuid())

    title String
    title_fa String
    url String

    categories Category[]

    products Product[]

    seoId String? @unique
    seo Seo? @relation(fields: [seoId],references: [id],onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}