model Seo {
  id                  String   @id @default(cuid())
  title               String
  description         String
  keywords            String[]
  slug                String   @unique
  canonical           String?
  image               String?
  og_title            String?
  og_description      String?
  og_image            String?
  twitter_title       String?
  twitter_description String?
  twitter_image       String?

  category Category?
  product  Product?
  brand    Brand?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}
